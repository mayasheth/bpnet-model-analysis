+def load_curated_modisco_motifs(motif_data_prefix: str):
+    """
+    Loads the saved bundle and performs basic shape sanity checks.
+
+    Returns: (motifs_df, cwms, trim_masks, names)
+    """
+    parquet_path = f"{motif_data_prefix}.motifs.parquet"
+    npz_path     = f"{motif_data_prefix}.motifs.npz"
+
+    motifs_df = pl.read_parquet(parquet_path)
+
+    with np.load(npz_path, allow_pickle=False) as z:
+        cwms       = z["cwms"]
+        trim_masks = z["trim_masks"]
+
+    names = motifs_df.filter(pl.col("strand") == "+").get_column("motif_name").to_numpy()
+
+    # Basic checks
+    if cwms.ndim != 3:
+        raise ValueError(f"cwms must be [N, 4, L]; got shape {cwms.shape}")
+    if trim_masks.ndim != 2:
+        raise ValueError(f"trim_masks must be [N, L]; got shape {trim_masks.shape}")
+    if cwms.shape[0] != trim_masks.shape[0] or cwms.shape[2] != trim_masks.shape[1]:
+        raise ValueError("cwms and trim_masks shapes are incompatible")
+
+    return motifs_df, cwms, trim_masks, names
+
