reference/*.narrowPeak
reference/*.gc.bed
reference/*.fa
reference/*.fai

# Model weights and training outputs
**/models/
**/models_h5/

# SHAP outputs (large NPZ/H5)
**/shap/
**/shap_peaks/
**/tangermeme_all_chr/
**/tangermeme_DNase/

# Prediction outputs - per-fold data (large H5/BW)
**/predictions_cv/fold*/
**/predictions_mean/fold*/
**/predictions_cv/all_folds/*.tsv.gz
**/predictions_mean/all_folds/*.tsv.gz
# Multimodal predictions dir (large)
**/predictions/

# MoDISCo HDF5 scores
**/modisco/**/*.h5
**/modisco_peaks/**/*.h5

# Motif spacing large files
**/motif_spacing/**/background_encoded.npy

# pixi environment
.pixi/

# SLURM logs
slurm_logs/
**/log/

# Python cache
__pycache__/
*.pyc
*.pyo
*.log

# Misc
.htaccess

# Exception: small reference motif files
!reference/*.npz

# Temp sort files from BigWig generation
**/data/tmp_bw_*/
**/data/*.bw

